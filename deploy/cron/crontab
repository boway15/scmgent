# scm-agent HTTP cron (Asia/Shanghai via TZ)
# Format: standard crontab → supercronic
# 任务错开，避免 08:00 与大体量飞书拉取挤在同一分钟

# 临时停用：stock_alert 近期单次跑 2–3h，会拖垮同进程上的飞书拉取（2026-08-13）
# 0 7 * * * /usr/local/bin/run-task.sh /api/tasks/stock-alert
20 7 * * * /usr/local/bin/run-task.sh /api/tasks/inventory-query-pull
40 7 * * * /usr/local/bin/run-task.sh /api/tasks/inventory-turnover-pull
0 8 * * * /usr/local/bin/run-task.sh /api/tasks/news-ingest
10 8 * * * /usr/local/bin/run-task.sh /api/tasks/procurement-bulk-stock-pull
20 8 * * * /usr/local/bin/run-task.sh /api/tasks/procurement-follow-up-pull
0 9 * * 1 /usr/local/bin/run-task.sh /api/tasks/replenishment-forecast
